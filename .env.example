# ══════════════════════════════════════════════════════════════════════════
# PdM System — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your values in .env
#   3. NEVER commit .env to version control
#   4. .env.example is safe to commit — it contains NO real secrets
# ══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME=pdm-system
APP_VERSION=0.1.0
DEBUG=true                   # Set to false in production

# ── API Security ───────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-strong-api-key-here
API_KEY_HEADER=X-API-Key

# ── API Server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                # Increase in production

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/pdm.db

# ── MLflow ─────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=pdm-predictive-maintenance

# ── Model ──────────────────────────────────────────────────────────────────
MODEL_PATH=./models/best_model.pkl
MODEL_VERSION=1.0.0

# ── Data ───────────────────────────────────────────────────────────────────
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
CMAPSS_SUBSET=FD001           # FD001 | FD002 | FD003 | FD004

# ── Drift Detection ────────────────────────────────────────────────────────
DRIFT_THRESHOLD=0.15          # Alert if drift score exceeds this
DRIFT_REFERENCE_WINDOW=1000   # Number of samples for reference distribution

# ── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_API_URL=http://localhost:8000
STREAMLIT_PORT=8501

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
